<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>jaytwo.Subprocess.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Select the netstandard2.0 assembly; NuGet resolves dependencies for the net10.0 host. -->
    <ProjectReference Include="..\..\src\jaytwo.Subprocess\jaytwo.Subprocess.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
    <Compile Include="..\jaytwo.Subprocess.UnitTests\**\*.cs"
             Exclude="..\jaytwo.Subprocess.UnitTests\bin\**;..\jaytwo.Subprocess.UnitTests\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\jaytwo.Subprocess.UnitTests\xunit.runner.json"
          Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
